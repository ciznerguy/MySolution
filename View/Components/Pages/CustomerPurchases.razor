@page "/customer-purchases"
@rendermode InteractiveServer
@using Model
@inject HttpClient Http

<h3>חיפוש רכישות לפי קוד לקוח</h3>

<div class="row mb-3">
    <div class="col-md-4 d-flex gap-2">
        <input type="number" class="form-control" placeholder="הכנס קוד לקוח" @bind="customerId" />
        <button class="btn btn-primary" @onclick="GetPurchases">חפש רכישות</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>שגיאה בתקשורת:</strong> @errorMessage
    </div>
}

@if (hasSearched)
{
    @if (purchases == null)
    {
        <p><em>טוען נתונים מה-API...</em></p>
    }
    else if (purchases.Count == 0)
    {
        <div class="alert alert-warning">
            לא נמצאו רכישות עבור לקוח מספר @searchedCustomerId.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered mt-3">
            <thead>
                <tr>
                    <th>קוד רכישה</th>
                    <th>שם מוצר</th>
                    <th>כמות</th>
                    <th>תאריך רכישה</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in purchases)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@(p.Product?.ProductName ?? "ללא שם מוצר")</td>
                        <td>@p.Quantity</td>
                        <td>@p.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private int customerId = 1;
    private int searchedCustomerId;
    private bool hasSearched = false;
    private string? errorMessage;
    private List<Purchase>? purchases;

    private async Task GetPurchases()
    {
        Console.WriteLine($"[Blazor Log] Button Clicked! Searching for customer ID: {customerId}");
        hasSearched = true;
        searchedCustomerId = customerId;
        purchases = null;
        errorMessage = null;

        try
        {
            string url = $"http://localhost:5108/api/purchases/customer/{customerId}";
            Console.WriteLine($"[Blazor Log] Sending GET request to API: {url}");

            purchases = await Http.GetFromJsonAsync<List<Purchase>>(url);
            Console.WriteLine($"[Blazor Log] Received response! Purchases count: {purchases?.Count ?? 0}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Blazor Error] Failed to fetch data: {ex.Message}");
            errorMessage = ex.Message;
            purchases = new List<Purchase>();
        }
    }
}